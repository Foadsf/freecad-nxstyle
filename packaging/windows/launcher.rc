// SPDX-License-Identifier: LGPL-2.1-or-later
// NX-Style.exe's resources: its icon, version information and manifest.
// The build passes NX_VERSION_STR ("0.1.0") and NX_VERSION_NUM (0,1,0,0).
#include <winver.h>
#include <winuser.h>

#ifndef NX_VERSION_STR
#define NX_VERSION_STR "0.0.0"
#endif
#ifndef NX_VERSION_NUM
#define NX_VERSION_NUM 0,0,0,0
#endif

1 ICON "../icons/nxstyle.ico"
1 RT_MANIFEST "launcher.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION NX_VERSION_NUM
PRODUCTVERSION NX_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FreeCAD NX-Style contributors"
            VALUE "FileDescription", "FreeCAD NX-Style"
            VALUE "FileVersion", NX_VERSION_STR
            VALUE "InternalName", "NX-Style"
            VALUE "LegalCopyright", "LGPL-2.1-or-later. Not affiliated with Siemens."
            VALUE "OriginalFilename", "NX-Style.exe"
            VALUE "ProductName", "FreeCAD NX-Style"
            VALUE "ProductVersion", NX_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
