      {"name": "Solvers", "items": [
        {"cmd": ["FEM_SolverCalculiX", "FEM_SolverCalculiXCcxTools", "FEM_SolverCalculixCxxtools"], "label": "CalculiX", "size": "large"},
        {"cmd": "FEM_SolverElmer", "label": "Elmer", "optional": true},
        {"cmd": "FEM_SolverMystran", "label": "Mystran", "optional": true},
        {"cmd": "FEM_SolverZ88", "label": "Z88", "optional": true},
        {"cmd": "FEM_SolverRun", "label": "Solve", "size": "large"},
        {"cmd": "FEM_SolverControl", "label": "Solver Job Control", "optional": true}
      ]},
      {"name": "Equations (Elmer)", "items": [
        {"cmd": "FEM_EquationElasticity", "label": "Elasticity", "optional": true},
