        {"cmd": "FEM_EquationElectrostatic", "label": "Electrostatic", "optional": true},
        {"cmd": "FEM_EquationMagnetodynamic", "label": "Magnetodynamic", "optional": true},
        {"cmd": "FEM_EquationDeformation", "label": "Deformation", "optional": true}
