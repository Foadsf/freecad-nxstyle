        {"cmd": "FEM_Analysis", "label": "New Analysis", "size": "large"},
        {"cmd": "FEM_Examples", "label": "Examples", "optional": true}
      ]},
      {"name": "2 Material", "step": "material", "items": [
        {"cmd": "FEM_MaterialSolid", "label": "Solid Material", "size": "large"},
        {"cmd": "FEM_MaterialFluid", "label": "Fluid Material"},
        {"cmd": "FEM_MaterialMechanicalNonlinear", "label": "Nonlinear Material"},
        {"cmd": "FEM_MaterialEditor", "label": "Material Editor", "optional": true}
      ]},
      {"name": "3 Loads and Constraints", "step": "loads", "items": [
        {"cmd": "FEM_ConstraintFixed", "label": "Fixed", "size": "large"},
        {"cmd": "FEM_ConstraintForce", "label": "Force", "size": "large"},
        {"cmd": "FEM_ConstraintPressure", "label": "Pressure"},
        {"cmd": "FEM_ConstraintDisplacement", "label": "Enforced Displacement"},
        {"cmd": "FEM_ConstraintSelfWeight", "label": "Gravity"},
        {"cmd": "FEM_ConstraintContact", "label": "Contact"}
