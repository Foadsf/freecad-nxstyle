      {"name": "5 Solve", "step": "solve", "items": [
        {"cmd": ["FEM_SolverCalculiX", "FEM_SolverCalculiXCcxTools", "FEM_SolverCalculixCxxtools"], "label": "CalculiX Solver", "size": "large"},
