/* SPDX-License-Identifier: LGPL-2.1-or-later
   NX-inspired light ribbon. Original styling; no Siemens assets are used.
   Colours are tokens (@nx-...) defined in theme.py, filled in when loaded. */

#NXRibbon { background: @nx-panel; }

#NXRibbonHeader { background: @nx-chrome; border-bottom: 1px solid @nx-line; }

#NXFileButton {
    background: @nx-accent; color: @nx-on-accent; font-weight: 600;
    border: none; padding: 5px 18px; margin: 0px 6px 0px 0px;
}
#NXFileButton:hover { background: @nx-accent-hover; }
#NXFileButton:pressed { background: @nx-accent-pressed; }
#NXFileButton::menu-indicator { image: none; width: 0px; }

#NXQuickAccess { background: transparent; border: none; spacing: 1px; padding: 0px 8px 0px 0px; }
#NXQuickAccess QToolButton { padding: 3px; border: 1px solid transparent; border-radius: 2px; }
#NXQuickAccess QToolButton:hover { background: @nx-tint; border: 1px solid @nx-tintline; }

#NXRibbonTabs { background: transparent; }
#NXRibbonTabs::tab {
    background: transparent; color: @nx-text-tab;
    padding: 6px 14px 5px 14px; margin: 0px;
    border: none; border-bottom: 2px solid transparent;
}
#NXRibbonTabs::tab:hover { color: @nx-text; background: @nx-tint; }
#NXRibbonTabs::tab:selected { color: @nx-accent; background: @nx-panel; border-bottom: 2px solid @nx-accent; }

#NXRibbonStack, #NXRibbonPage, #NXRibbonPageInner { background: @nx-panel; }
#NXRibbonStack { border-bottom: 1px solid @nx-line; }

#NXRibbonGroup { background: transparent; }
#NXRibbonGroupLabel { color: @nx-label; font-size: 8pt; padding: 1px 0px 2px 0px; }
#NXRibbonSeparator { color: @nx-line-soft; margin: 6px 2px 6px 2px; }

QToolButton#NXRibbonButton {
    color: @nx-text; border: 1px solid transparent; border-radius: 3px;
    padding: 2px 4px 2px 4px; background: transparent;
}
QToolButton#NXRibbonButton:hover { background: @nx-tint; border: 1px solid @nx-tintline; }
QToolButton#NXRibbonButton:pressed, QToolButton#NXRibbonButton:checked {
    background: @nx-tint2; border: 1px solid @nx-tintline-strong;
}
QToolButton#NXRibbonButton:disabled { color: @nx-disabled; }
QToolButton#NXRibbonButton::menu-button { border: none; width: 12px; }
QToolButton#NXRibbonButton::menu-button:hover { background: @nx-tint2; }
QToolButton#NXRibbonButton:focus, QToolButton#NXRibbonGroupButton:focus, QToolButton#NXRibbonOverflow:focus {
    border: 1px solid @nx-accent;
}

/* a collapsed group and the More menu: one button that lists the commands */
QToolButton#NXRibbonGroupButton, QToolButton#NXRibbonOverflow {
    color: @nx-text; border: 1px solid transparent; border-radius: 3px;
    padding: 2px 6px 2px 6px; background: transparent;
}
QToolButton#NXRibbonGroupButton:hover, QToolButton#NXRibbonOverflow:hover { background: @nx-tint; border: 1px solid @nx-tintline; }
QToolButton#NXRibbonGroupButton:pressed, QToolButton#NXRibbonOverflow:pressed { background: @nx-tint2; }
QToolButton#NXRibbonOverflow { border-left: 1px solid @nx-line-soft; }

/* guided workflow (Simulation): the next step stands out, finished steps are ticked */
#NXRibbonGroupLabel[nxstep="next"] { color: @nx-accent; font-weight: 600; }
#NXRibbonGroupLabel[nxstep="done"] { color: @nx-muted; }
#NXRibbonGroup[nxstep="next"] { border-bottom: 2px solid @nx-accent; }

#NXCollapseButton { border: none; padding: 3px; border-radius: 2px; }
#NXCollapseButton:hover { background: @nx-tint; }

QLineEdit#NXCommandFinder {
    border: 1px solid @nx-field; border-radius: 12px; padding: 3px 10px;
    background: @nx-panel; color: @nx-text; margin: 2px 0px;
}
QLineEdit#NXCommandFinder:hover { border: 1px solid @nx-tintline; }
QLineEdit#NXCommandFinder:focus { border: 1px solid @nx-accent; }

QToolButton#NXRibbonScroll { background: @nx-overlay; border: none; border-left: 1px solid @nx-line; border-right: 1px solid @nx-line; }
QToolButton#NXRibbonScroll:hover { background: @nx-tint; }
