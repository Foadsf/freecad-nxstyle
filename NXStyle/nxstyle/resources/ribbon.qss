/* SPDX-License-Identifier: LGPL-2.1-or-later
   NX-inspired light ribbon. Original styling; no Siemens assets are used. */

#NXRibbon { background: #F5F6F7; }

#NXRibbonHeader { background: #E4E7EA; border-bottom: 1px solid #C9CED3; }

#NXFileButton {
    background: #00737A; color: white; font-weight: bold;
    border: none; padding: 4px 16px; margin: 0px 4px 0px 0px;
}
#NXFileButton:hover { background: #008C94; }
#NXFileButton::menu-indicator { image: none; width: 0px; }

#NXQuickAccess { background: transparent; border: none; spacing: 0px; padding: 0px 6px 0px 0px; }
#NXQuickAccess QToolButton { padding: 2px; border: 1px solid transparent; }
#NXQuickAccess QToolButton:hover { background: #D3E6F5; border: 1px solid #9FC6E6; }

#NXRibbonTabs { background: transparent; }
#NXRibbonTabs::tab {
    background: transparent; color: #2B2F33;
    padding: 4px 12px 4px 12px; margin: 2px 0px 0px 0px;
    border: 1px solid transparent; border-bottom: none;
}
#NXRibbonTabs::tab:hover { background: #EEF4F9; }
#NXRibbonTabs::tab:selected {
    background: #F5F6F7; border: 1px solid #C9CED3; border-bottom: 1px solid #F5F6F7;
    color: #00737A;
}

#NXRibbonStack, #NXRibbonPage, #NXRibbonPageInner { background: #F5F6F7; }

#NXRibbonGroup { background: transparent; }
#NXRibbonGroupLabel { color: #5A6066; font-size: 8pt; padding-top: 1px; }
#NXRibbonSeparator { color: #D3D7DB; margin: 4px 0px 4px 0px; }

QToolButton#NXRibbonButton {
    color: #1F2326; border: 1px solid transparent; border-radius: 2px;
    padding: 1px 3px 1px 3px; background: transparent;
}
QToolButton#NXRibbonButton:hover { background: #D3E6F5; border: 1px solid #9FC6E6; }
QToolButton#NXRibbonButton:pressed, QToolButton#NXRibbonButton:checked {
    background: #B9D7EF; border: 1px solid #78AEDB;
}
QToolButton#NXRibbonButton:disabled { color: #9AA0A6; }

#NXCollapseButton { border: none; padding: 2px; }

QLineEdit#NXCommandFinder {
    border: 1px solid #B8BEC4; border-radius: 2px; padding: 2px 6px;
    background: white; min-width: 210px; color: #1F2326;
}
QLineEdit#NXCommandFinder:focus { border: 1px solid #00737A; }

QScrollArea#NXRibbonPage QScrollBar:horizontal { height: 7px; background: #E9ECEF; border: none; }
QScrollArea#NXRibbonPage QScrollBar::handle:horizontal { background: #B8BEC4; border-radius: 3px; min-width: 40px; }
QScrollArea#NXRibbonPage QScrollBar::add-line:horizontal, QScrollArea#NXRibbonPage QScrollBar::sub-line:horizontal { width: 0px; }
